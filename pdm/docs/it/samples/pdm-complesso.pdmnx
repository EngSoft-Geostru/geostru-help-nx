                "anomalie": [
                  {
                    "nome": "Danneggiamento",
                    "guastiAlterazioniIrregolarita": "Diminuzione più o meno grave ed evidente di consistenza.",
                    "effettoInconvenienti": "Scortecciamento del tronco, sviluppo di malattie fitosanitarie o dovute ad insetti, essiccamento e morte della pianta.",
                    "cause": "Atti di vandalismo, colpi accidentali.",
                    "criterioIntervento": "Sostituzione",
                    "id": "17b0ee7105b5",
                    "stampa": true
                  },
                  {
                    "nome": "Deposito superficiale",
                    "guastiAlterazioniIrregolarita": "Accumulo di materiali che  generalmente hanno scarsa coerenza ed aderenza al materiale sottostante.",
                    "effettoInconvenienti": "Formazione di un tappeto sottostante l'albero di foglie rosso porpora sul terreno. Presenza di fiori e frutti giunti a maturazione. Rischio di scivolamento per l'utenza, a seguito della formazione di uno strato colloso. Macchiatura del suolo sottostante.",
                    "cause": "Caducità delle foglie, caduta di fiori e frutti, scortecciamento.",
                    "criterioIntervento": "Pulizia",
                    "id": "6b031ffeada1",
                    "stampa": true
                  },
                  {
                    "nome": "Essiccamento",
                    "guastiAlterazioniIrregolarita": "Perdita progressiva delle funzioni vitali.",
                    "effettoInconvenienti": "Alterazione dell'equilibrio ambientale della zona, immagine di degrado e di abbandono.",
                    "cause": "Malattie fitosanitarie, crittogamiche o dovute ad insetti, tranciamento delle radici, cause accidentali (fulmine, ecc.), assenza di manutenzione.",
                    "criterioIntervento": "Sostituzione",
                    "id": "6b454b7d0949",
                    "stampa": true
                  }
