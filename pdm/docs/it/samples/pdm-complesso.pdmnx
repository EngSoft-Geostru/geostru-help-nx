              },
              {
                "nome": "Scala interna",
                "descrizione": "Elemento di collegamento verticale fra piani posti a livelli diversi, localizzato all'interno dell'edificio, che ha come fine quello di rendere alla persona il percorso rapido ed agevole.\r\nDal punto di vista costruttivo essa si compone di due parti:\r\n- struttura portante, realizzata in cemento armato, eseguita insieme alle opere al rustico dell'edificio;\r\n- opere di finitura, comprendenti la tinteggiatura dell'intradosso della soletta ed il rivestimento in marmo del rustico dei gradini, eseguiti entrambi in conclusione dei lavori al fine di non danneggiare i materiali già rifiniti.",
                "componenti": "Finitura sup. intradosso: Tinteggiatura (Pitture e vernici): Tempera",
                "datiDimensionali": "",
                "tipo": 1,
                "istruzioni": {
                  "modoUsoCorretto": "Poiché raramente a distanza di tempo si riuscirà a trovare lo stesso tipo di rivestimento dei gradini, è opportuno dotarsi di una scorta del materiale originario per eventuali lavori di riparazione e manutenzione che dovessero necessitare.\r\nEvitare di far cadere sulle pavimentazioni oggetti pesanti od appuntiti, non versare sostanze corrosive, non usare calzature che possano causare graffi o abrasioni.",
                  "modoEsecuzioneInstallazione": "Rampe e pianerottoli costituiti da soletta in calcestruzzo armato e da rivestimento dall'estradosso con pietra naturale levigata e lucidata. Intonacatura dell'intradosso del solaio con premiscelati a base di gesso, per uno spessore di cm 1,5. Finitura superficiale con tinta tipo tempera. Rivestimento allettato su sottofondo a base cementizia e stuccato con cemento bianco.",
                  "istruzioniDismissione": "ISTRUZIONI PER LO STOCCAGGIO DELLE MATERIE\r\nSeparare le armature metalliche dagli inerti.\r\n\r\nINDICAZIONI PER IL RICICLAGGIO\r\nInerti riutilizzabili quale riempimento nell'ambito del cantiere.",
                  "normeSicurezzaDismissione": "",
                  "danniPossibili": "",
                  "modalitaIntervento": "",
                  "centriAssistenza": ""
                },
                "prestazioni": [
                  {
                    "nome": "Estetici",
                    "descrizione": "Capacità del materiale o del componente di mantenere inalterato l'aspetto esteriore.",
                    "livelloMinimoPrestazioni": "Garantire uniformità delle eventuali modificazioni dell'aspetto, senza compromettere requisiti funzionali.",
                    "norme": "D.M. 22/01/2008 n. 37; DPR 26 agosto 1993, n. 412; DPR 21 dicembre 1999, n. 551.",
                    "vitaNominale": null,
                    "id": "1fdbe0b1f509",
                    "stampa": true
                  },
                  {
                    "nome": "Funzionalità",
                    "descrizione": "La capacità del materiale o del componente di garantire il funzionamento e l'efficienza previsti in fase di progetto.",
                    "livelloMinimoPrestazioni": "Stabilito in funzione del materiale o dell'impianto, dalle norme UNI riportate sul capitolato speciale d'appalto.",
                    "norme": "UNI 8212; UNI 8872.\r\nDecreto Ministeriale 22 gennaio 2008, n. 37 \"Regolamento …riordino delle disposizioni in materia di attività di installazione degli impianti all'interno degli edifici.\"",
                    "vitaNominale": null,
                    "id": "102dd4acf8c2",
                    "stampa": true
                  },
                  {
                    "nome": "Sicurezza d'uso",
                    "descrizione": "Capacità del materiale o del componente di garantire l'utilizzabilità senza rischi per l'utente.",
                    "livelloMinimoPrestazioni": "Assenza di rischi per l'utente.",
                    "norme": "D.Lgs. 81/2008; Legge 01/03/68 n. 186; DPR 29/07/82 n. 577; D.M. 22/01/2008 n. 37; DPR 6/12/91 n. 447; DM 30/06/95 n. 418.",
                    "vitaNominale": null,
                    "id": "7d0b82d52b25",
                    "stampa": true
                  },
                  {
                    "nome": "Stabilità",
                    "descrizione": "Capacità dell'elemento di permetterne l'uso pur in presenza di lesioni.",
                    "livelloMinimoPrestazioni": "Stabilito in funzione del materiale dalle norme UNI o da prescrizioni normative riportate sul capitolato speciale d'appalto.",
                    "norme": "D.M. 17/01/2018",
                    "vitaNominale": null,
                    "id": "68bc95e559f1",
                    "stampa": true
                  }
                ],
                "anomalie": [
                  {
                    "nome": "Alterazione della finitura superficiale",
                    "guastiAlterazioniIrregolarita": "Variazione del livello qualitativo della finitura superficiale.",
                    "effettoInconvenienti": "Incremento della porosità e rugosità della superficie, diminuzione della lucidatura, variazione cromatica, aspetto degradato.",
                    "cause": "Assenza di adeguato trattamento protettivo, polvere.",
                    "criterioIntervento": "Lucidatura, ripristino brillantezza superficiale.",
                    "id": "2d88c79f9a21",
                    "stampa": true
                  },
                  {
                    "nome": "Deposito superficiale",
                    "guastiAlterazioniIrregolarita": "Accumulo di materiali estranei di varia natura, generalmente con scarsa coerenza e aderenza al materiale sottostante.",
                    "effettoInconvenienti": "Presenza di polvere e sporco più o meno resistente sul rivestimento e sulle fughe. Formazione di striature e macchie. Mancata garanzia di igiene ed asetticità",
                    "cause": "Trascinamento di polvere e residui organici dovuto alle normali abitudini comportamentali dell'utenza (apertura di porte e finestre, camminamento, ecc.).",
                    "criterioIntervento": "Pulizia ordinaria e/o di fondo, smacchiatura.",
                    "id": "1ed2f84ea160",
                    "stampa": true
                  },
                  {
                    "nome": "Distacco",
                    "guastiAlterazioniIrregolarita": "Rimozione da una posizione di contatto.",
                    "effettoInconvenienti": "Sollevamento di alcuni elementi di rivestimento dei gradini che si manifesta con la mancata planarietà dello stesso.",
                    "cause": "Perdita del legame tra rivestimento e sottofondo per problematiche imputabili al sistema ed ai prodotti impiegati nella posa. Possibili dilatazioni e contrazioni.",
                    "criterioIntervento": "Ripristino parziale planarietà rivestimento.",
                    "id": "bf3a036363f1",
                    "stampa": true
                  },
                  {
                    "nome": "Lesione",
                    "guastiAlterazioniIrregolarita": "Rottura che si manifesta in una qualsiasi struttura quando lo sforzo a cui è sottoposta supera la resistenza corrispondente del materiale.",
                    "effettoInconvenienti": "Fenditure più o meno ramificate e profonde individuabili sull'intradosso ed estradosso della soletta.",
                    "cause": "Assestamento differenziale delle fondazioni. Ritiro dell'intonaco per granulometria troppo piccola dell'inerte o per eccesso di legante.",
                    "criterioIntervento": "Ispezione  tecnico specializzato, ripristino integrità rivestimento, ripristino parziale o rinnovo totale tinteggiatura ed intonaco intradosso soletta.",
                    "id": "e6bdfcf6ab83",
                    "stampa": true
                  },
                  {
                    "nome": "Scagliatura",
                    "guastiAlterazioniIrregolarita": "Distacco totale o parziale di scaglie di materiale con forma e spessore irregolari e dimensioni variabili.",
                    "effettoInconvenienti": "Scheggiatura rivestimento e battiscopa contigui.",
                    "cause": "Urti e simili.",
                    "criterioIntervento": "Sostituzione totale o parziale di rivestimento e battiscopa.",
                    "id": "b3a96b21f446",
                    "stampa": true
                  }
                ],
