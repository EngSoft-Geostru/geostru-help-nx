                ],
                "anomalie": [
                  {
                    "nome": "Distacco",
                    "guastiAlterazioniIrregolarita": "Rimozione da una posizione di contatto.",
                    "effettoInconvenienti": "Sollevamento di alcune piastrelle che si manifesta con la mancata planarietà della pavimentazione.",
                    "cause": "Insufficienza dei giunti tecnici per possibili dilatazioni.",
                    "criterioIntervento": "Ripristino parziale pavimentazione.",
                    "id": "97712688991b",
                    "stampa": true
                  },
                  {
                    "nome": "Lesione",
                    "guastiAlterazioniIrregolarita": "Rottura che si manifesta in una qualsiasi struttura quando lo sforzo a cui è sottoposta supera la resistenza corrispondente del materiale.",
                    "effettoInconvenienti": "Fenditure più o meno ramificate e profonde.",
                    "cause": "Assestamento differenziale delle fondazioni.",
                    "criterioIntervento": "Ripristino parziale pavimentazione.",
                    "id": "9edb7e0f53de",
                    "stampa": true
                  },
                  {
                    "nome": "Scagliatura",
                    "guastiAlterazioniIrregolarita": "Distacco totale o parziale di scaglie di materiale di forma e spessore irregolari e dimensioni variabili.",
                    "effettoInconvenienti": "Scheggiatura di una o più piastrelle contigue.",
                    "cause": "Urti e simili.",
                    "criterioIntervento": "Sostituzione del singolo pezzo.",
                    "id": "8097f50532ff",
                    "stampa": true
                  },
                  {
                    "nome": "Umidità ascendente",
                    "guastiAlterazioniIrregolarita": "Presenza più o meno accentuata di vapore acqueo in risalita dal sottosuolo per capillarità.",
                    "effettoInconvenienti": "Chiazze di umidità. Condensa. Variazione di microclima interno. Presenza di microrganismi o organismi (es. funghi, muffe, insetti, ecc.). Diminuzione della resistenza al calore.",
                    "cause": "Infiltrazione di acqua in risalita dalla falda freatica o da acque disperse (dispersione da fogne e tubazioni, errato smaltimento acque meteoriche).",
                    "criterioIntervento": "Contattare tecnico specializzato.",
                    "id": "5b02ec93c99b",
                    "stampa": true
                  }
                ],
