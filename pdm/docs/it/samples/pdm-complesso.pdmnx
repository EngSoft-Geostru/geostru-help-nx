                "interventi": [
                  {
                    "nome": "Pulizia",
                    "modalitaEsecuzione": "Eseguire una pulizia dei pozzetti mediante asportazione dei fanghi di deposito e lavaggio con acqua a pressione.",
                    "frequenza": {
                      "valore": "6",
                      "unita": "Mesi"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Dopo forti piogge.",
                    "esecutore": "Specializzati vari",
                    "noteCorrettaEsecuzione": "",
                    "eseguibileDallUtente": false,
