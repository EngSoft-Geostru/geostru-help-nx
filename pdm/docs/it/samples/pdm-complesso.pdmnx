                  },
                  {
                    "nome": "Pulizia filtri",
                    "modalitaEsecuzione": "Effettuare una pulizia del filtro dell'acqua, dell'aria sia delle macchine che dei terminali presenti, degli umidificatori ad acqua andando a rimuoverli, portarli in luoghi privi di persone e spruzzarli con aria. In caso di forti incrostazioni lavare i filtri con acqua.",
                    "frequenza": {
                      "valore": "3",
                      "unita": "Mesi"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "",
