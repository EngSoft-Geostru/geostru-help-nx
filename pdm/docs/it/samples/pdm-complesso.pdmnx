          {
            "nome": "Impianto elettrico industriale",
            "descrizione": "",
            "collocazione": "Edificio: piano terra, livelli superiori e locali tecnici; vedi S01.",
            "note": "Ubicazione dimostrativa. Nel caso reale associare ogni componente alla posizione e al manuale del produttore.",
            "elementiTecnici": [
              {
                "nome": "Impianto di messa a terra",
                "descrizione": "L'impianto di messa a terra deve garantire la possibilità di collegamento ad un conduttore a potenziale nullo per  ciascun elemento dell'impianto elettrico . In caso di guasto le parti metalliche entrate accidentalmente in contatto con conduttori in tensione, devono essere portate allo stesso potenziale del terreno circostante. L'impianto di terra di un edificio deve essere unico e ad esso dovranno essere collegati tutti gli elementi suscettibili di introdurre potenziale diverso all'interno dell'edificio.",
                "componenti": "Morsetti (Elettrico - Apparati)",
                "datiDimensionali": "",
                "tipo": 0,
                "istruzioni": {
                  "modoUsoCorretto": "Non disconnettere i conduttori di protezione.",
                  "modoEsecuzioneInstallazione": "Installati i conduttori GIALLOVERDE di collegamento alla rete di terra, assicurarsi della efficacia dei collegamenti e verificare la resistenza verso terra dell'impianto.",
                  "istruzioniDismissione": "ISTRUZIONI PER LO STOCCAGGIO DELLE MATERIE\r\nConservare in luoghi asciutti e in assenza di umidità, non esporre ai raggi UVA per tempi lunghi.\r\n\r\nPROCEDURE PER LO SMALTIMENTO\r\nSecondo le procedure di legge in quanto non assimilabile ai normali RSU.\r\nAccertarsi che il materiale sia ripulito da materiali di classe diversa; stoccarlo in appositi contenitori per evitarne la dispersione in ambiente.\r\n\r\nINDICAZIONI PER IL RICICLAGGIO\r\nSeparazione dei cavi da eventuali terminali.\r\nSeparazione di eventuali parti metalliche e plastiche.",
                  "normeSicurezzaDismissione": "",
                  "danniPossibili": "Elettrocuzione per mancanza di collegamento elettrico alla rete di terra;",
                  "modalitaIntervento": "",
                  "centriAssistenza": ""
                },
                "prestazioni": [
                  {
                    "nome": "Funzionalità",
                    "descrizione": "La capacità del materiale o del componente di garantire il funzionamento e l'efficienza previsti dalle norme.",
                    "livelloMinimoPrestazioni": "Garantire in ogni situazione il mantenimento della resistenza verso terra indicata sul progetto e coordinata con gli altri elementi dell'impianto elettrico.",
                    "norme": "DECRETO LEGISLATIVO 9 aprile 2008 , n. 81.\r\nAttuazione dell'articolo 1 della legge 3 agosto 2007, n. 123, in materia di tutela della salute e della sicurezza nei luoghi di lavoro;\r\nDecreto Ministeriale 22 gennaio 2008, n. 37 \"Regolamento …riordino delle disposizioni in materia di attività di installazione degli impianti all'interno degli edifici.\";\r\nLegge 01/03/68 n. 186 Disposizioni concernenti la produzione di materiali, apparecchiature, macchinari, installazioni e impianti elettrici ed elettronici;\r\nLegge 18/10/77 n. 791 \"Attuazione della direttiva del Consiglio delle Comunità europee (n° 73/23/CEE) relativa alle garanzie di sicurezza che deve possedere il materiale elettrico destinato ad essere utilizzato entro alcuni limiti di tensione\".",
                    "vitaNominale": null,
                    "id": "9c2a5a199cc5",
                    "stampa": true
                  },
                  {
                    "nome": "Sicurezza d'uso",
                    "descrizione": "Capacità del materiale o del componente di garantire l'utilizzabilità senza rischi per l'utente.",
                    "livelloMinimoPrestazioni": "Garantire in ogni situazione il mantenimento della resistenza verso terra indicata sul progetto e coordinata con gli altri elementi dell'impianto elettrico per garantire la sicurezza d'uso dell'impianto.",
                    "norme": "D.Lgs. 81/2008; Legge 01/03/68 n. 186; Legge 18/10/77 n. 791; DPR 29/07/82 n. 577; D.M. 22/01/2008 n. 37; Legge 28/03/91 n.109; DPR 6/12/91 n. 447; DM 20/02/92; DM 20/5/92 n. 569; DM 23/05/92 n. 314; DM 26/8/92; DM 09/04/94; DM 30/06/95 n. 418; DM 18/03/96; DM 19/08/96; D.Lgs 25/09/96.",
                    "vitaNominale": null,
                    "id": "15344745a2e4",
                    "stampa": true
                  }
                ],
