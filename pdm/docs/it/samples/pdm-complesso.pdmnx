                    "stampa": true
                  },
                  {
                    "nome": "Pulizia ordinaria 1",
                    "modalitaEsecuzione": "Al fine di garantire una adeguata igiene ed asetticità, eseguire una pulizia ordinaria finalizzata all'asportazione di polvere e macchie di sostanze comuni.\r\nNel caso di macchie o sporco più resistente si può intervenire con una soluzione a base di acqua calda e un idoneo prodotto per la pulizia.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Giorni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Non usare solventi, acidi o sostanze corrosive.",
                    "eseguibileDallUtente": true,
                    "id": "22aab06d497a",
                    "stampa": true
                  },
                  {
