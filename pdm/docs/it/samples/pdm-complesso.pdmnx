                "anomalie": [
                  {
                    "nome": "Blistering",
                    "guastiAlterazioniIrregolarita": "Formazione di bolle dovute al distacco di uno strato dal supporto.",
                    "effettoInconvenienti": "Avallamenti della guaina che ostacolano lo smaltimento delle acque.",
                    "cause": "Fissaggio della guaina inefficiente, scorrimenti plastici.",
                    "criterioIntervento": "Ripristino fissaggio della guaina.",
                    "id": "b26a794afd6a",
                    "stampa": true
                  },
                  {
                    "nome": "Deformazione",
                    "guastiAlterazioniIrregolarita": "Alterazione duratura dell'aspetto e della configurazione, misurabile dalla variazione delle distanze tra i suoi punti.",
                    "effettoInconvenienti": "Variazione profilo del solaio, rigonfiamenti, distacchi e lesioni, smaltimento acque meteoriche alterato.",
                    "cause": "Cedimenti del solaio.",
                    "criterioIntervento": "Ispezione tecnico, ripristino integrità manto di copertura.",
                    "id": "05d8ff6b0226",
                    "stampa": true
                  },
                  {
                    "nome": "Degradazione chimico-fisica",
                    "guastiAlterazioniIrregolarita": "Modificazione che implica un peggioramento.",
                    "effettoInconvenienti": "Indurimento, variazione della rugosità superficiale, fessurizzazione e scorrimenti plastici permanenti con conseguenti distacchi.",
                    "cause": "Esposizione prolungata ai raggi ultravioletti, salti termici (cicli di gelo e disgelo ), errata valutazione dell'idoneità del materiale al contesto climatico.",
                    "criterioIntervento": "Rifacimento parziale o totale del manto.",
                    "id": "a70a875a5748",
                    "stampa": true
                  },
                  {
                    "nome": "Deposito superficiale",
                    "guastiAlterazioniIrregolarita": "Accumulo di materiali estranei di varia natura, generalmente con scarsa coerenza e aderenza al materiale sottostante.",
                    "effettoInconvenienti": "Accumulo scorie di vario tipo (fogliame, piume, ecc.) e materiale di risulta (ferro, macerie, plastica, sabbia, legno, cavi, ecc.) sulla copertura, smaltimento acque meteoriche ostacolato, danneggiamento tegole, presenza di polvere, macchie e sporco più o meno resistente sulle piastrelle e sulle fughe, formazione di striature e macchie, mancata garanzia di igiene ed asetticità.",
                    "cause": "Agenti atmosferici, deiezioni animali, abbandono di materiale sulla copertura durante le operazioni di manutenzione.",
                    "criterioIntervento": "Pulizia.",
                    "id": "88b95c182228",
                    "stampa": true
                  },
                  {
                    "nome": "Distacco",
                    "guastiAlterazioniIrregolarita": "Rimozione da una posizione di contatto.",
                    "effettoInconvenienti": "Mancato contatto e/o sigillatura tra i bordi dei fogli di guaina. Infiltrazione di acqua negli strati sottostanti.",
                    "cause": "Sovrapposizione dei fogli insufficiente, fissaggio tra i fogli inesistente per mancata fusione della parte inferiore del foglio superiore, insufficienza dei giunti tecnici per possibili dilatazioni e contrazioni, deformazioni.",
                    "criterioIntervento": "Sigillatura dei fogli, ispezione tecnico specializzato.",
                    "id": "c178d8771c88",
                    "stampa": true
                  },
                  {
                    "nome": "Lesione",
                    "guastiAlterazioniIrregolarita": "Rottura che si manifesta in una qualsiasi struttura quando lo sforzo a cui è sottoposta supera la resistenza corrispondente del materiale.",
                    "effettoInconvenienti": "Fenditure più o meno ramificate e profonde individuabili sull'intradosso ed estradosso del solaio.",
                    "cause": "Assestamento differenziale delle fondazioni, deformazione, ritiro dell'intonaco per granulometria troppo piccola dell'inerte o per eccesso di legante.",
                    "criterioIntervento": "Ispezione tecnico specializzato, ripristino integrità manto di copertura, ripristino parziale o rinnovo totale tinteggiatura ed intonaco intradosso solaio.",
                    "id": "54fed228ee12",
                    "stampa": true
                  },
                  {
                    "nome": "Umidità da infiltrazione",
                    "guastiAlterazioniIrregolarita": "Presenza più o meno accentuata di vapore acqueo.",
                    "effettoInconvenienti": "Chiazze di umidità sull'intradosso del solaio di copertura, condensa, variazione di microclima interno, presenza di microrganismi o organismi (es. funghi, muffe, insetti, ecc.), diminuzione della resistenza al calore dei locali.",
                    "cause": "Distacco della guaina, usura sigillature giunti, evacuazione acque piovane insufficiente per scarsa pendenza del solaio e/o intasamento del discendente.",
                    "criterioIntervento": "Sigillatura dei giunti, ripristino parziale o rinnovo totale del manto di copertura, ripristino parziale o rinnovo totale tinteggiatura ed intonaco intradosso solaio, ispezione tecnico specializzato.",
                    "id": "8522a8147e8d",
                    "stampa": true
                  }
                ],
