                    ],
                    "nome": "Visiva sull'elemento tecnico",
                    "modalitaEsecuzione": "Accertarsi che sull'intradosso del solaio non vi siano: tracce di infiltrazioni d'acqua causa di muffe, macchie, colature condensate sulle pareti fredde, marcescenza dell'intonaco con sfarinamento, gonfiatura e distacco. Verificare che sulla pavimentazione non vi siano: scheggiature, mancata planarietà, fenditure più o meno ramificate, nonché tracce di umidità.",
                    "frequenza": {
                      "valore": "6",
                      "unita": "Mesi"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Maggio-Novembre",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "In caso di riscontro problematiche: contattare tecnico specializzato in modo da individuare la causa e procedere all'eliminazione della stessa tramite apposita ditta; effettuare l'operazione di ripulitura.",
                    "eseguibileDallUtente": true,
                    "id": "38125422d0a9",
                    "stampa": true
                  }
                ],
                "interventi": [
                  {
                    "nome": "Pulizia di fondo",
                    "modalitaEsecuzione": "Mediante un'energica azione meccanica di spazzolatura, rimuovere lo sporco presente nelle fughe.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Mesi"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Non usare solventi, acidi e sostanze corrosive, onde evitare possibili incidenti, apporre segnali indicanti pericolo per pavimentazione bagnata.",
                    "eseguibileDallUtente": true,
                    "id": "61257a20f4ed",
                    "stampa": true
                  },
                  {
                    "nome": "Pulizia ordinaria 1",
                    "modalitaEsecuzione": "Al fine di garantire una adeguata igiene ed asetticità, eseguire una pulizia ordinaria finalizzata all'asportazione di polvere e macchie di sostanze comuni. Nel caso di macchie o sporco più resistente si può intervenire con una soluzione a base di acqua calda e un idoneo prodotto per la pulizia.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Giorni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Fuori orario di lavoro",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Non usare solventi, acidi o sostanze corrosive, onde evitare possibili incidenti, apporre segnali indicanti pericolo per pavimentazione bagnata.",
                    "eseguibileDallUtente": true,
