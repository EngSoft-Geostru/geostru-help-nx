                    "id": "6942b56f72ac",
                    "stampa": true
                  },
                  {
                    "nome": "Riparazione",
                    "modalitaEsecuzione": "Riparazioni di eventuali buche e/o fessurazioni mediante ripristino degli strati di fondo, pulizia e rifacimento degli strati superficiali con l'impiego di bitumi stradali a caldo. Rifacimento di giunti degradati.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Anni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "",
                    "esecutore": "Specializzati vari",
                    "noteCorrettaEsecuzione": "",
