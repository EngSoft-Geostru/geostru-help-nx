                    ],
                    "nome": "Visiva sull'elemento tecnico",
                    "modalitaEsecuzione": "Accertarsi che non vi siano: scheggiature, mancata planarietà e fenditure più o meno ramificate sulla pavimentazione. \r\nVerificare inoltre l'assenza di  tracce di umidità, marcescenza dell'intonaco con sfarinamento,  gonfiatura e distacco.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Anni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "In caso di riscontro problematiche: contattare tecnico specializzato in modo da individuare la causa e procedere all'eliminazione della stessa tramite apposita ditta; effettuare l'operazione di ripulitura.",
                    "eseguibileDallUtente": true,
                    "id": "50abcd7fd6a6",
                    "stampa": true
                  }
                ],
                "interventi": [
                  {
                    "nome": "Lucidatura ordinaria",
                    "modalitaEsecuzione": "Nel caso di pavimenti lucidi di recente esecuzione, dopo la pulizia, ravvivare semplicemente la lucidatura passando a secco dei panni morbidi o degli appositi dischi lucidanti, ad esempio nylon.\r\nQuando questo sistema non cominciasse a dare più i suoi frutti e si verificasse un aumento di porosità del pavimento, iniziare un trattamento periodico a base di idonee emulsioni acquose lucidanti, attenendosi scrupolosamente alle dosi indicate dal produttore durante l'uso.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Settimane"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Fuori orario di lavoro.",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Nel caso di pavimenti lucidi di recente esecuzione, è da evitare l'uso di emulsioni lucidanti.\r\nOnde evitare possibili incidenti, apporre segnali indicanti pericolo per pavimentazione bagnata.",
                    "eseguibileDallUtente": true,
                    "id": "9599456832a6",
                    "stampa": true
                  },
                  {
                    "nome": "Pulizia di fondo",
                    "modalitaEsecuzione": "Lavaggio a fondo con acqua e detergenti neutri concentrati o candeggina ed asciugatura con mezzi o macchine adatte alle caratteristiche tecniche del materiale e conformi alle indicazioni dei produttori.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Mesi"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Fuori orario di lavoro",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Evitare detergenti acidi forti, onde evitare possibili incidenti, apporre segnali indicanti pericolo per pavimentazione bagnata.",
                    "eseguibileDallUtente": true,
                    "id": "7c58345472fb",
                    "stampa": true
                  },
                  {
                    "nome": "Pulizia ordinaria",
                    "modalitaEsecuzione": "Al fine di garantire una adeguata igiene ed asetticità, eseguire una pulizia ordinaria finalizzata all'asportazione di polvere e macchie di sostanze comuni. Dopo una prima passata di scopa morbida, far seguire una passata di straccio inumidito con sola acqua calda (non bollente). Se necessario usare saltuariamente anche gli appositi detergenti (al fine di non asportare la finitura superficiale per corrosione del materiale, è importante che risultino neutri). Dopo l'uso di queste sostanze risciacquare bene la superficie con acqua mantenuta pulita.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Giorni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Fuori orario di lavoro.",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Non usare solventi, acidi o sostanze corrosive, onde evitare possibili incidenti, apporre segnali indicanti pericolo per pavimentazione bagnata.",
                    "eseguibileDallUtente": true,
                    "id": "2d44dbfb74fb",
                    "stampa": true
                  },
                  {
                    "nome": "Rinnovo",
                    "modalitaEsecuzione": "Rinnovo intonaco dell'intradosso soletta.",
                    "frequenza": {
                      "valore": "20",
                      "unita": "Anni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Periodi con temperature comprese tra 5° e 25°",
                    "esecutore": "Impresa specializzata",
                    "noteCorrettaEsecuzione": "Attrezzature da utilizzare: D.P.I., utensili vari, trabattello.",
                    "eseguibileDallUtente": false,
                    "id": "2186e31d2d83",
                    "stampa": true
                  },
                  {
                    "nome": "Ripristino",
                    "modalitaEsecuzione": "Eventuali piccoli lavori di ripristino planarietà ed integrità del rivestimento attraverso la sostituzione parziale, il rifissaggio di rivestimenti e battiscopa e/o sigillatura fughe.",
                    "frequenza": {
                      "valore": "10",
                      "unita": "Anni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Estivo",
                    "esecutore": "Piastrellista",
                    "noteCorrettaEsecuzione": "Attrezzature da utilizzare: D.P.I., utensili vari, mola.",
                    "eseguibileDallUtente": false,
                    "id": "cfc4cca727f1",
                    "stampa": true
                  },
                  {
                    "nome": "Ripristino brillantezza superficiale",
                    "modalitaEsecuzione": "Applicazione di tecniche e prodotti specifici a seconda del materiale e del tipo di lucidatura (lucidatura a piombo, trattamento cristallizzante dei marmi, protezione antiusura autolucidante, protezione lucidante per ardesia a base oleosa). \r\nI trattamenti si applicano ai pavimenti lucidati o levigati con macchine ed operatori specializzati. I trattamenti cristallizzanti devono essere ripetuti frequentemente, le protezioni lucidanti saltuariamente.",
                    "frequenza": {
                      "valore": "15",
                      "unita": "Giorni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Fuori orario di lavoro.",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Attenersi scrupolosamente alle indicazioni dei produttori, onde evitare possibili incidenti, apporre segnali indicanti pericolo per pavimentazione bagnata.",
                    "eseguibileDallUtente": true,
                    "id": "436db70175d7",
                    "stampa": true
                  },
                  {
                    "nome": "Ritinteggiatura",
                    "modalitaEsecuzione": "Rinnovo tinteggiatura intradosso soletta.",
                    "frequenza": {
                      "valore": "5",
                      "unita": "Anni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Aprile",
                    "esecutore": "Impresa specializzata",
                    "noteCorrettaEsecuzione": "Attrezzature da utilizzare: D.P.I., trabattello, pennello, rullo.",
                    "eseguibileDallUtente": false,
                    "id": "6d664125796b",
                    "stampa": true
                  },
                  {
                    "nome": "Smacchiatura",
                    "modalitaEsecuzione": "Rimozione delle macchie con detergenti alcalini o tecniche e prodotti specifici; da eseguire in relazione al materiale lapideo ed al tipo di sostanza smacchiante, di impronta o di residuo\r\nSuccessivo lavaggio con acqua ed asciugatura.",
                    "frequenza": {
                      "valore": "1",
                      "unita": "Mesi"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Fuori orario di lavoro.",
                    "esecutore": "utente",
                    "noteCorrettaEsecuzione": "Usare prodotti compatibili con le caratteristiche tecniche dei materiali  e conformi alle indicazioni dei produttori. Onde evitare possibili incidenti, apporre segnali indicanti pericolo per pavimentazione bagnata.",
                    "eseguibileDallUtente": true,
                    "id": "83c1d5f4bb5c",
                    "stampa": true
                  },
                  {
                    "nome": "Sostituzione",
                    "modalitaEsecuzione": "Rinnovo totale o parziale di rivestimento e battiscopa.",
                    "frequenza": {
                      "valore": "50",
                      "unita": "Anni"
                    },
                    "periodoConsigliato": "",
                    "noteManutenzione": "Estivo",
                    "esecutore": "Piastrellista",
                    "noteCorrettaEsecuzione": "Attrezzature da utilizzare: D.P.I., demolitore elettrico, mola, utensili vari.",
                    "eseguibileDallUtente": false,
                    "id": "016b087cfd23",
