            ],
            "id": "2fe51a44839c",
            "stampa": true
          },
          {
            "nome": "Collegamento verticale",
            "descrizione": "",
            "collocazione": "Edificio: piano terra, livelli superiori e locali tecnici; vedi S01.",
            "note": "Ubicazione dimostrativa. Nel caso reale associare ogni componente alla posizione e al manuale del produttore.",
            "elementiTecnici": [
              {
                "nome": "Scala esterna",
                "descrizione": "Elemento di collegamento verticale fra piani posti a livelli diversi, localizzato all'esterno dell'edificio, che ha come fine quello di rendere alla persona il percorso rapido ed agevole.\r\nDal punto di vista costruttivo essa si compone di due parti:\r\n- struttura portante, realizzata in cemento armato a vista, eseguita insieme alle opere al rustico dell'edificio;\r\n- opere di finitura, comprendenti il rivestimento del rustico dei gradini, eseguiti in conclusione dei lavori al fine di non danneggiare il marmo già rifinito.",
                "componenti": "Battiscopa (Pietre): Travertino chiaro romano",
                "datiDimensionali": "",
                "tipo": 1,
                "istruzioni": {
                  "modoUsoCorretto": "Poiché raramente a distanza di tempo si riuscirà a trovare lo stesso tipo di rivestimento dei gradini, è opportuno dotarsi di una scorta del materiale originario per eventuali lavori di riparazione e manutenzione che dovessero necessitare.\r\nEvitare di far cadere sulle pavimentazioni oggetti pesanti od appuntiti, non versare sostanze corrosive, non usare calzature che possano causare graffi o abrasioni.",
                  "modoEsecuzioneInstallazione": "Rampe e pianerottoli costituiti da soletta in calcestruzzo armato a vista (intradosso) e da rivestimento dall'estradosso con pietra naturale levigata e lucidata. Rivestimento allettato su sottofondo a base cementizia e successiva stuccatura delle fughe con apposito prodotto antigelivo capace di ridurre sensibilmente l'assorbimento di umidità.",
                  "istruzioniDismissione": "ISTRUZIONI PER LO STOCCAGGIO DELLE MATERIE\r\nSeparare le armature metalliche dagli inerti.\r\n\r\nINDICAZIONI PER IL RICICLAGGIO\r\nInerti riutilizzabili quale riempimento nell'ambito del cantiere\r\nRiutilizzabili quale riempimento nell'ambito del cantiere.",
                  "normeSicurezzaDismissione": "",
                  "danniPossibili": "",
                  "modalitaIntervento": "",
                  "centriAssistenza": ""
                },
                "prestazioni": [
                  {
                    "nome": "Estetici",
                    "descrizione": "Capacità del materiale o del componente di mantenere inalterato l'aspetto esteriore.",
                    "livelloMinimoPrestazioni": "Garantire uniformità delle eventuali modificazioni dell'aspetto, senza compromettere requisiti funzionali.",
                    "norme": "D.M. 22/01/2008 n. 37; DPR 26 agosto 1993, n. 412; DPR 21 dicembre 1999, n. 551.",
                    "vitaNominale": null,
                    "id": "ec710cbb2e70",
                    "stampa": true
                  },
                  {
                    "nome": "Funzionalità",
                    "descrizione": "La capacità del materiale o del componente di garantire il funzionamento e l'efficienza previsti in fase di progetto.",
                    "livelloMinimoPrestazioni": "Stabilito in funzione del materiale o dell'impianto, dalle norme UNI riportate sul capitolato speciale d'appalto.",
                    "norme": "UNI 8212; UNI 8872.\r\nDecreto Ministeriale 22 gennaio 2008, n. 37 \"Regolamento …riordino delle disposizioni in materia di attività di installazione degli impianti all'interno degli edifici.\"",
                    "vitaNominale": null,
                    "id": "d5627302fa4e",
                    "stampa": true
                  },
                  {
                    "nome": "Resistenza attacchi biologici",
                    "descrizione": "Capacità del materiale di resistere agli attacchi di microrganismi o organismi animali e/o vegetali  che possano alterarne le caratteristiche.",
                    "livelloMinimoPrestazioni": "Variabili in funzione del materiale, delle condizioni di posa nonché della localizzazione rispetto a fattori in grado di favorire la proliferazione degli agenti biologici ( esposizione, umidità ecc).",
                    "norme": "UNI EN 1339:2005.",
                    "vitaNominale": null,
                    "id": "96fb4e1f707a",
                    "stampa": true
                  },
                  {
                    "nome": "Sicurezza d'uso",
                    "descrizione": "Capacità del materiale o del componente di garantire l'utilizzabilità senza rischi per l'utente.",
                    "livelloMinimoPrestazioni": "Assenza di rischi per l'utente.",
                    "norme": "D. Lgs 30 aprile 1992 - Nuovo codice della strada; D.P.R.16 dicembre 1992, n. 495. - Regolamento di esecuzione e di attuazione del nuovo Codice della Strada.",
                    "vitaNominale": null,
                    "id": "648f548b9432",
                    "stampa": true
                  },
                  {
                    "nome": "Stabilità",
                    "descrizione": "Capacità dell'elemento di permetterne l'uso pur in presenza di lesioni.",
                    "livelloMinimoPrestazioni": "Stabilito in funzione del materiale dalle norme UNI o da prescrizioni normative riportate sul capitolato speciale d'appalto.",
                    "norme": "D.M. 17/01/2018",
                    "vitaNominale": null,
                    "id": "aa918fcf61cb",
                    "stampa": true
                  },
                  {
                    "nome": "Tenuta ai fluidi",
                    "descrizione": "Capacità del materiale o del componente di impedire ai fluidi di oltrepassarlo.",
                    "livelloMinimoPrestazioni": "Assenza di perdite, infiltrazioni.",
                    "norme": "UNI 8212; UNI 8872.",
                    "vitaNominale": null,
                    "id": "2891e25c47e8",
                    "stampa": true
                  }
                ],
                "anomalie": [
                  {
                    "nome": "Alterazione della finitura superficiale",
                    "guastiAlterazioniIrregolarita": "Variazione del livello qualitativo della finitura superficiale.",
                    "effettoInconvenienti": "Incremento della porosità e rugosità della superficie, diminuzione della lucidatura, variazione cromatica, aspetto degradato.",
                    "cause": "Irraggiamento solare diretto, assenza di adeguato trattamento protettivo, inquinamento atmosferico, polvere.",
                    "criterioIntervento": "Lucidatura, ripristino brillantezza superficiale.",
                    "id": "988232328869",
                    "stampa": true
                  },
                  {
                    "nome": "Deposito superficiale",
                    "guastiAlterazioniIrregolarita": "Accumulo di materiali estranei di varia natura, generalmente con scarsa coerenza e aderenza al materiale sottostante.",
                    "effettoInconvenienti": "Presenza di polvere e sporco più o meno resistente sul rivestimento e sulle fughe. Formazione di striature e macchie. Mancata garanzia di igiene ed asetticità.",
                    "cause": "Trascinamento di polvere e residui organici dovuto alle normali abitudini comportamentali dell'utenza (apertura di porte e finestre, camminamento, ecc.). Agenti atmosferici. Deiezioni animali. Assenza di elementi di protezione alla pioggia, vento, ecc.",
                    "criterioIntervento": "Pulizia ordinaria e/o di fondo, smacchiatura.",
                    "id": "53ab448ae531",
                    "stampa": true
                  },
                  {
                    "nome": "Distacco",
                    "guastiAlterazioniIrregolarita": "Rimozione da una posizione di contatto.",
                    "effettoInconvenienti": "Sollevamento di alcuni elementi di rivestimento dei gradini che si manifesta con la mancata planarietà dello stesso. Infiltrazione di acqua negli strati sottostanti",
                    "cause": "Perdita del legame tra rivestimento e sottofondo per problematiche imputabili al sistema ed ai prodotti impiegati nella posa. Possibili dilatazioni e contrazioni. Cicli di gelo e disgelo.",
                    "criterioIntervento": "Ripristino parziale planarietà rivestimento.",
                    "id": "95704257fe27",
                    "stampa": true
                  },
                  {
                    "nome": "Fessurazione",
                    "guastiAlterazioniIrregolarita": "Formazione di lesioni e spaccature.",
                    "effettoInconvenienti": "Presenza di fenditure, formazione di muschi, caduta di frammenti, infiltrazioni d'acqua, pericolo per l'utenza.",
                    "cause": "Penetrazione di acqua, cicli di gelo e disgelo.",
                    "criterioIntervento": "Ripristino integrità rivestimento (applicazione di stucchi specifici, ecc.), sostituzione.",
                    "id": "f43991738e99",
                    "stampa": true
                  },
                  {
                    "nome": "Lesione",
                    "guastiAlterazioniIrregolarita": "Rottura che si manifesta in una qualsiasi struttura quando lo sforzo a cui è sottoposta supera la resistenza corrispondente del materiale.",
                    "effettoInconvenienti": "Fenditure più o meno ramificate e profonde individuabili sull'intradosso ed estradosso della soletta.",
                    "cause": "Assestamento differenziale delle fondazioni. Cicli di gelo e disgelo.",
                    "criterioIntervento": "Ispezione  tecnico specializzato, ripristino integrità rivestimento.",
                    "id": "aa6634c0d30a",
                    "stampa": true
                  },
                  {
                    "nome": "Rottura",
                    "guastiAlterazioniIrregolarita": "Menomazione dell'integrità di un elemento e danneggiamento grave.",
                    "effettoInconvenienti": "Fenomeni di infiltrazione d'acqua piovana, pericolo per l'utente.",
                    "cause": "Urti e simili, cicli di gelo e disgelo.",
                    "criterioIntervento": "Sostituzione parziale del rivestimento.",
                    "id": "43333a2e3191",
                    "stampa": true
                  },
                  {
                    "nome": "Scagliatura",
                    "guastiAlterazioniIrregolarita": "Distacco totale o parziale di scaglie di materiale con forma e spessore irregolari e dimensioni variabili.",
                    "effettoInconvenienti": "Scheggiatura rivestimento e battiscopa contigui.",
                    "cause": "Urti e simili, cicli di gelo e disgelo, penetrazione di acqua.",
                    "criterioIntervento": "Sostituzione totale o parziale di rivestimento e battiscopa.",
                    "id": "f582b458e6bb",
                    "stampa": true
                  },
                  {
                    "nome": "Spalling",
                    "guastiAlterazioniIrregolarita": "Distacco del copriferro del cemento armato lungo uno spigolo per effetto delle tensioni interne di trazione, prodotte in genere dall'ossidazione dell'armatura.",
                    "effettoInconvenienti": "Armature a vista lungo gli spigoli dell'intradosso soletta, cedimenti dovuti ad indebolimenti strutturali",
                    "cause": "Umidità, cicli di gelo e disgelo.",
                    "criterioIntervento": "Ispezione tecnico specializzato per ripristino integrità struttura.",
                    "id": "39a0604592bd",
                    "stampa": true
                  },
                  {
                    "nome": "Umidità da infiltrazione",
                    "guastiAlterazioniIrregolarita": "Presenza più o meno accentuata di vapore acqueo.",
                    "effettoInconvenienti": "Chiazze di umidità sul rivestimento e/o sull'intradosso della soletta, presenza di microrganismi o organismi (es. funghi, muffe, insetti, ecc.).",
                    "cause": "Usura sigillature fughe, evacuazione acque piovane insufficiente per scarsa acquatura dei gradini.",
                    "criterioIntervento": "Sigillatura fughe rivestimento, ispezione tecnico specializzato.",
                    "id": "872174a86518",
                    "stampa": true
                  }
                ],
