          },
          {
            "nome": "Chiusura verticale portata",
            "descrizione": "",
            "collocazione": "Edificio: piano terra, livelli superiori e locali tecnici; vedi S01.",
            "note": "Ubicazione dimostrativa. Nel caso reale associare ogni componente alla posizione e al manuale del produttore.",
            "elementiTecnici": [
              {
                "nome": "Divisorio interno tinteggiato",
                "descrizione": "Divisorio interno,  tinteggiato su entrambi i lati, avente la funzione di delimitare i vani interni all'opera in oggetto.",
                "componenti": "Finitura sup.: Tinteggiatura (Pitture e vernici): Tempera",
                "datiDimensionali": "",
                "tipo": 0,
                "istruzioni": {
                  "modoUsoCorretto": "Effettuare gli ancoraggi in rapporto al peso: oggetti leggeri (es. quadri) ancoraggio da effettuare mediante chiodi in acciaio o tasselli; oggetti pesanti (es. lampadari, mensole, librerie) impiego di tasselli ad espansione. In caso di ancoraggio di peso considerevole o dell'apertura di fori o vani di notevole entità è consigliabile rivolgersi ad un tecnico. Particolare attenzione va posta al momento della foratura, in presenza di impianti e tubature che concorrono all'interno dei tramezzi. Il loro eventuale danneggiamento, oltre a compromettere l'efficienza dell'impianto stesso, può determinare danni anche a chi sta eseguendo l'operazione di ancoraggio.",
                  "modoEsecuzioneInstallazione": "Elementi di laterizio forato con caratteristiche simili a quello impiegato nelle tamponature esterne. Posa di detti elementi con malta cementizia identica a quella impiegata nelle pareti esterne, garantendo così una maggiore omogeneità di comportamento alla sollecitazioni strutturali. Intonaco della parete, per uno spessore medio di 1.5 cm per lato, del tipo premiscelato liscio a base gesso. Finitura superficiale su entrambi i lati costituita da tinteggiatura a tempera.",
                  "istruzioniDismissione": "ISTRUZIONI DI SMALTIMENTO\r\nPrima di procedere allo smaltimento presso discarica autorizzata, è necessario prestare massima attenzione alla scomposizione dell'elemento tecnologico al fine di procedere alla suddivisione dei vari materiali.",
                  "normeSicurezzaDismissione": "",
                  "danniPossibili": "",
                  "modalitaIntervento": "",
                  "centriAssistenza": ""
                },
                "prestazioni": [
                  {
                    "nome": "Benessere termoigrometrico",
                    "descrizione": "Capacità del materiale o del componente di garantire il mantenimento delle condizioni apprezzate dagli occupanti gli ambienti, nei limiti dei parametri statistici di accettabilità.",
                    "livelloMinimoPrestazioni": "Stabilito dagli occupanti gli ambienti.",
                    "norme": "D.M. 22/01/2008 n. 37; DPR 26 agosto 1993, n. 412; DPR 21 dicembre 1999, n. 551.",
                    "vitaNominale": null,
                    "id": "abb447e48f54",
                    "stampa": true
                  },
                  {
                    "nome": "Estetici",
                    "descrizione": "Capacità del materiale o del componente di mantenere inalterato l'aspetto esteriore.",
                    "livelloMinimoPrestazioni": "Garantire uniformità delle eventuali modificazioni dell'aspetto, senza compromettere requisiti funzionali.",
                    "norme": "D.M. 22/01/2008 n. 37; DPR 26 agosto 1993, n. 412; DPR 21 dicembre 1999, n. 551.",
                    "vitaNominale": null,
                    "id": "3d2f07faee4a",
                    "stampa": true
                  },
                  {
                    "nome": "Resistenza attacchi biologici",
                    "descrizione": "Capacità del materiale di resistere agli attacchi di microrganismi o organismi animali e/o vegetali  che possano alterarne le caratteristiche.",
                    "livelloMinimoPrestazioni": "Variabili in funzione del materiale, delle condizioni di posa nonché della localizzazione rispetto a fattori in grado di favorire la proliferazione degli agenti biologici (esposizione, umidità ecc).",
                    "norme": "UNI EN 1339:2005.",
                    "vitaNominale": null,
                    "id": "ffff375f39a5",
                    "stampa": true
                  },
                  {
                    "nome": "Stabilità",
                    "descrizione": "Capacità dell'elemento di permetterne l'uso pur in presenza di lesioni.",
                    "livelloMinimoPrestazioni": "Stabilito in funzione del materiale dalle norme UNI o da prescrizioni normative riportate sul capitolato speciale d'appalto.",
                    "norme": "D.M. 17/01/2018",
                    "vitaNominale": null,
                    "id": "6fbf419e5735",
                    "stampa": true
                  }
                ],
                "anomalie": [
                  {
                    "nome": "Deposito superficiale",
                    "guastiAlterazioniIrregolarita": "Accumulo di materiali estranei di varia natura, generalmente con scarsa coerenza e aderenza al materiale sottostante.",
                    "effettoInconvenienti": "Presenza di polvere, terra e sporco più o meno resistente sulla finitura, mancata garanzia di igiene ed asetticità, aspetto degradato.",
                    "cause": "Trascinamento di polvere e residui organici dovuto alle normali abitudini comportamentali dell'utenza (apertura di porte e finestre, ecc.).",
                    "criterioIntervento": "Ripristino parziale o rinnovo totale tinteggiatura.",
                    "id": "fbb46b9e658b",
