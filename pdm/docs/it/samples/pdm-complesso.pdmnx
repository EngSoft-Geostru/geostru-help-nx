        "unitaTecnologiche": [
          {
            "nome": "Chiusura orizzontale portante",
            "descrizione": "",
            "collocazione": "Edificio: piano terra, livelli superiori e locali tecnici; vedi S01.",
            "note": "Ubicazione dimostrativa. Nel caso reale associare ogni componente alla posizione e al manuale del produttore.",
            "elementiTecnici": [
              {
                "nome": "Copertura piana con guaina di impermeabilizzazione",
                "descrizione": "Copertura piana non praticabile costituita da:\r\n- struttura portante, costituita da un solaio a giacitura orizzontale, in cui vengono opportunamente previsti i giunti di dilatazione così da consentire contrazioni e dilatazioni libere dovute a sbalzi di temperatura;\r\n- manto di tenuta ed impermeabilizzazione, che impedisce l'infiltrazione dell'acqua ed assicura l'isolamento termoacustico; \r\n- strato di finitura dell'intradosso del solaio.",
                "componenti": "Finitura sup. interna: tinteggiatura  (Pitture e vernici): Tempera",
                "datiDimensionali": "",
                "tipo": 1,
                "istruzioni": {
                  "modoUsoCorretto": "E' opportuno dotarsi di una scorta del materiale di finitura  originario per eventuali lavori di riparazione e manutenzione, poiché raramente a distanza di tempo si riuscirà a trovare lo stesso tipo di materiale. Non salire sulla copertura se privi di sistemi di sicurezza.",
                  "modoEsecuzioneInstallazione": "Solaio di tipo misto ottenuto inserendo nella struttura file di pignatte alternate con travetti in c.a.p., cartonfeltro bitumato applicato a secco con giunti sovrapposti di 10 cm e stesura di soletta in conglomerato cementizio alleggerito da argilla espansa. Lo strato di tenuta all'acqua è realizzato con membrane in fogli che, stesi in sito a fiamma con giunti sovrapposti di 10 cm, realizzano uno strato continuo. \r\nIntonacatura dell'intradosso del solaio con premiscelati a base di gesso, per uno spessore di cm 1,5. Finitura superficiale con tinta tipo tempera.",
                  "istruzioniDismissione": "PROCEDURE PER LO SMALTIMENTO\r\nPrima di procedere allo smaltimento presso discarica autorizzata, è necessario prestare massima attenzione alla scomposizione dell'elemento tecnologico al fine di procedere alla suddivisione dei vari materiali.",
                  "normeSicurezzaDismissione": "",
                  "danniPossibili": "",
                  "modalitaIntervento": "",
                  "centriAssistenza": ""
                },
