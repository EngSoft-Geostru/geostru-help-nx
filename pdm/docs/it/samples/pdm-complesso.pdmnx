                    "descrizione": "Capacità del materiale o del componente di garantire l'utilizzabilità senza rischi per l'utente.",
                    "livelloMinimoPrestazioni": "Assenza di rischi per l'utente.",
                    "norme": "UNI EN 27574; UNI 7137; UNI 7138; UNI 7139.",
                    "vitaNominale": null,
                    "id": "b3c5b1380f93",
                    "stampa": true
                  }
                ],
                "anomalie": [
                  {
                    "nome": "Alterazione della finitura",
                    "guastiAlterazioniIrregolarita": "Variazione del livello qualitativo della finitura superficiale.",
                    "effettoInconvenienti": "Incremento della porosità e rugosità della superficie, diminuzione della lucidatura, variazione cromatica, aspetto degradato.",
                    "cause": "Irraggiamento solare diretto, assenza di adeguato trattamento protettivo, ambiente particolarmente umido, polvere.",
                    "criterioIntervento": "Lucidatura, verniciatura.",
                    "id": "bfcd0e9bca2f",
                    "stampa": true
                  },
                  {
                    "nome": "Deposito superficiale",
                    "guastiAlterazioniIrregolarita": "Accumulo di materiali estranei di varia natura, generalmente con scarsa coerenza e aderenza al materiale sottostante.",
                    "effettoInconvenienti": "Presenza di polvere, terra e sporco più o meno resistente sulla seduta e negli interstizi, impraticabilità della seduta, mancata garanzia di igiene, scarso comfort degli utenti, aspetto degradato.",
                    "cause": "Trascinamento di polvere e residui organici dovuto: agli agenti atmosferici, alle normali abitudini comportamentali dell'utenza, inquinamento atmosferico, assenza di elementi di protezione alla pioggia, vento, ecc.",
                    "criterioIntervento": "Pulizia",
                    "id": "4b56a3516a1d",
                    "stampa": true
                  },
                  {
                    "nome": "Esfoliazione",
                    "guastiAlterazioniIrregolarita": "Degradazione che si manifesta con sollevamento, seguito da distacco, di uno o più sottili strati superficiali paralleli tra loro.",
                    "effettoInconvenienti": "Sollevamento con successivo distacco dello strato superficiale delle barre.",
                    "cause": "Infiltrazione d'acqua, penetrazione di umidità e conseguente rigonfiamento.",
                    "criterioIntervento": "Sostituzione delle barre.",
                    "id": "192909e054c7",
                    "stampa": true
                  },
                  {
                    "nome": "Rottura",
                    "guastiAlterazioniIrregolarita": "Menomazione dell'integrità e/o danneggiamento grave per sconnessione dei collegamenti.",
                    "effettoInconvenienti": "Scarso comfort degli utenti, pericolo per l'utenza, aspetto degradato, indebolimento della struttura.",
                    "cause": "Atti di vandalismo, obsolescenza",
                    "criterioIntervento": "Ripristino integrità, sostituzione.",
                    "id": "96050c4d1cde",
                    "stampa": true
                  }
                ],
