                ],
                "anomalie": [
                  {
                    "nome": "Corrosione",
                    "guastiAlterazioniIrregolarita": "Degradazione che implica l'evolversi di un processo chimico.",
                    "effettoInconvenienti": "Formazione di striature di ruggine nelle cerniere, con successiva possibile macchiatura dell'infisso, cattivo funzionamento delle cerniere.",
                    "cause": "Esposizione diretta alle acque meteoriche, salsedine, mancato trattamento anticorrosivo, umidità.",
                    "criterioIntervento": "Sostituzione delle cerniere.",
                    "id": "4925168e1d4d",
                    "stampa": true
                  },
                  {
                    "nome": "Danneggiamento",
                    "guastiAlterazioniIrregolarita": "Diminuzione più o meno grave ed evidente di efficienza e di consistenza di un elemento (vetro).",
                    "effettoInconvenienti": "Presenza di lesioni, aspetto degradato.",
                    "cause": "Cause accidentali, atti di vandalismo.",
                    "criterioIntervento": "Sostituzione lastra in vetro.",
                    "id": "817e95fc83de",
                    "stampa": true
                  },
                  {
                    "nome": "Deformazione",
                    "guastiAlterazioniIrregolarita": "Alterazione duratura dell'aspetto o della configurazione, misurabile dalla variazione delle distanze tra i suoi punti.",
                    "effettoInconvenienti": "Difetto di funzionamento nell'apertura e nella chiusura, pericolo per l'utenza, aspetto degradato.",
                    "cause": "Quantità di cerniere insufficiente.",
                    "criterioIntervento": "Incremento cerniera",
                    "id": "52c04d8df29e",
                    "stampa": true
                  },
                  {
                    "nome": "Deposito superficiale",
                    "guastiAlterazioniIrregolarita": "Accumulo di materiali estranei di varia natura, generalmente con scarsa coerenza e aderenza al materiale sottostante.",
                    "effettoInconvenienti": "Presenza di polvere, terra e sporco più o meno resistente sull'infisso e sulla mensola, mancata garanzia di igiene ed asetticità, aspetto degradato.",
                    "cause": "Trascinamento di polvere e residui organici dovuto: agli agenti atmosferici, alle normali abitudini comportamentali dell'utenza. Deiezioni animali, inquinamento atmosferico, assenza elementi di protezione alla pioggia, vento, ecc..",
                    "criterioIntervento": "Pulizia dell'infisso e della mensola.",
                    "id": "dc7981cae65c",
                    "stampa": true
                  },
                  {
                    "nome": "Fessurazione",
                    "guastiAlterazioniIrregolarita": "Formazione di lesioni e spaccature sulla mensola del davanzale.",
                    "effettoInconvenienti": "Formazione di muschi, caduta di frammenti, infiltrazioni di acqua.",
                    "cause": "Penetrazione di acqua, cicli di gelo e disgelo.",
                    "criterioIntervento": "Ripristino integrità (applicazione di stucchi specifici, ecc.)., costituzione mensola.",
                    "id": "96254bcb4786",
                    "stampa": true
                  },
                  {
                    "nome": "Grippaggio",
                    "guastiAlterazioniIrregolarita": "Inceppamento tra due pezzi per eccesso di attrito.",
                    "effettoInconvenienti": "Difetto di funzionamento nell'apertura e nella chiusura dell'infisso.",
                    "cause": "Mancanza di lubrificante nelle cerniere.",
                    "criterioIntervento": "Lubrificazione delle cerniere.",
                    "id": "762526e5c61d",
                    "stampa": true
                  },
                  {
                    "nome": "Lesione",
                    "guastiAlterazioniIrregolarita": "Rottura che si manifesta in una qualsiasi struttura quando lo sforzo a cui è sottoposta supera la resistenza corrispondente del materiale.",
                    "effettoInconvenienti": "Fenditure più o meno ramificate e profonde (es. lesione capillare, macroscopica, ecc.) sulla mensola del davanzale.",
                    "cause": "Cicli di gelo e disgelo, penetrazione di acqua.",
                    "criterioIntervento": "Ripristino integrità o sostituzione della mensola.",
                    "id": "0c8712575e7e",
                    "stampa": true
                  },
                  {
                    "nome": "Macchia",
                    "guastiAlterazioniIrregolarita": "Alterazione cromatica.",
                    "effettoInconvenienti": "Modificazione circoscritta dell'aspetto con formazione di striature e chiazze identificabili per variazione di lucentezza, colore ed intensità, su parete sottostante la bucatura ed inquadramento finestra. Erosione superficiale. Aspetto degradato.",
                    "cause": "Sporcamento dell'acqua piovana in discesa sulla facciata per: mancata o insufficiente pulizia della mensola del davanzale (es. eliminazione deiezioni animali); assenza dell'opportuna inclinazione della mensola.",
                    "criterioIntervento": "Ripristino parziale o rinnovo totale tinteggiatura, pulizia davanzale mensola bucatura.",
                    "id": "ce232803ebff",
                    "stampa": true
                  },
                  {
                    "nome": "Perdita di tenuta",
                    "guastiAlterazioniIrregolarita": "Mancata resistenza all'aria, all'acqua ed al vento.",
                    "effettoInconvenienti": "Infiltrazioni d'acqua, passaggi di aria, formazione di condensa",
                    "cause": "Problematiche legate alle guarnizioni ed ai giunti di tenuta: perdita dell'elasticità ovvero delle proprietà meccaniche iniziali, inaderenza ai profili di contatto dei telai, fuoriuscita dalle proprie sedi. Umidità.",
                    "criterioIntervento": "Sostituzione di giunti e guarnizioni di tenuta.",
                    "id": "34870c1ced84",
                    "stampa": true
                  },
                  {
                    "nome": "Rottura",
                    "guastiAlterazioniIrregolarita": "Menomazione dell'integrità di un elemento e danneggiamento grave.",
                    "effettoInconvenienti": "Perdita del potere isolante, mancato isolamento acustico, aspetto degradato, difficoltà di apertura e chiusura.",
                    "cause": "Cause accidentali, atti di vandalismo, inefficienza di cardini e congegni di chiusura.",
                    "criterioIntervento": "Sostituzione lastra in vetro, riparazione o sostituzione cardini e congegni di chiusura.",
                    "id": "1764fd45e89d",
                    "stampa": true
                  },
                  {
                    "nome": "Scagliatura",
                    "guastiAlterazioniIrregolarita": "Distacco totale o parziale di scaglie di materiale di forma e spessore irregolari e dimensioni variabili.",
                    "effettoInconvenienti": "Scheggiatura e sfarinatura del rivestimento. Pericolo per l'utenza per possibili cadute di frammenti.",
                    "cause": "Cicli di gelo e disgelo, penetrazione di acqua.",
                    "criterioIntervento": "Ripristino integrità o sostituzione mensola.",
                    "id": "585833ff6fbd",
                    "stampa": true
                  }
                ],
