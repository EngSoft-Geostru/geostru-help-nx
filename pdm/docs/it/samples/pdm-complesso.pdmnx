              {
                "nome": "Quadro e linee di distribuzione",
                "descrizione": "",
                "componenti": "Sportello (Materiale plastico)",
                "datiDimensionali": "",
                "tipo": 0,
                "istruzioni": {
                  "modoUsoCorretto": "Azionamento degli interruttori di protezione delle linee senza forzare gli stessi o bloccarli.",
                  "modoEsecuzioneInstallazione": "Cablatura del quadro secondo gli schemi di progetto, utilizzando cavi della sezione indicata.",
                  "istruzioniDismissione": "ISTRUZIONI PER LO STOCCAGGIO DELLE MATERIE\r\nConservare in luoghi asciutti e lontano da fonti di calore.\r\n\r\nPROCEDURE PER LO SMALTIMENTO\r\nSecondo le procedure di legge in quanto non assimilabile ai normali RSU.",
                  "normeSicurezzaDismissione": "",
                  "danniPossibili": "",
                  "modalitaIntervento": "Prima di ogni intervento sulle lampade assicurarsi che l'interruttore sia spento ed in caso di dubbio staccare l'interruttore generale, elettricista.",
                  "centriAssistenza": ""
                },
