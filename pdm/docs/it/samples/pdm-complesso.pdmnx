                  }
                ],
                "id": "7e528d649b8d",
                "stampa": true
              }
            ],
            "id": "d6d5761c7540",
            "stampa": true
          },
          {
            "nome": "Impianto antincendio",
            "descrizione": "L'impianto antincendio è l'insieme degli elementi tecnici aventi funzione di prevenire, eliminare, limitare o segnalare incendi. L'impianto antincendio per edifici del terziario è generalmente costituito da :\r\n- rete idrica di adduzione in ferro zincato oppure in polietilene ad alta densità ( anello );\r\n- bocche di incendio in cassetta (manichette, lance, ecc.);\r\n- attacchi per motopompe dei VV.FF;\r\n- estintori (idrici, a polvere, a schiuma, ecc.);\r\n- serbatoio di accumulo calcolato secondo le norme vigenti.",
            "collocazione": "Edificio: piano terra, livelli superiori e locali tecnici; vedi S01.",
            "note": "Ubicazione dimostrativa. Nel caso reale associare ogni componente alla posizione e al manuale del produttore.",
            "elementiTecnici": [
              {
                "nome": "Estintori",
                "descrizione": "A polvere (di tipo pressurizzato con aria o azoto, l'erogazione viene effettuata con tubo flessibile e ugello erogatore o con bomboletta di anidride carbonica in cui l'erogazione viene effettuata con tubo flessibile e pistola ad intercettazione).",
                "componenti": "Estintore",
                "datiDimensionali": "",
                "tipo": 0,
                "istruzioni": {
                  "modoUsoCorretto": "Gli estintori vanno collocati in prossimità di accessi e di apparecchiature a rischio, lungo i corridoi di accesso e nei punti di maggior pericolo facendo si che siano ben visibili, di facile accesso e protetti dagli urti. Non vanno esposti al gelo. Per l'utilizzo tirare la sicura ed impugnare l'estintore dirigendo il getto estinguente alla base dell'incendio. Per la manutenzione degli estintori riferirsi alla norma UNI 9994. L'estinguente può essere tenuto costantemente in pressione con gas compresso o messo in pressione al momento dell'utilizzo con una cartuccia di CO2. Gli estintori devono essere accompagnati dai certificati di omologazione.",
                  "modoEsecuzioneInstallazione": "",
                  "istruzioniDismissione": "",
                  "normeSicurezzaDismissione": "",
                  "danniPossibili": "",
                  "modalitaIntervento": "",
                  "centriAssistenza": ""
                },
                "prestazioni": [
                  {
                    "nome": "Funzionalità",
                    "descrizione": "La capacità del materiale o del componente di garantire il funzionamento e l'efficienza previsti in fase di progetto.",
                    "livelloMinimoPrestazioni": "Stabilito in funzione del materiale o dell'impianto, dalle norme UNI riportate sul capitolato speciale d'appalto.",
                    "norme": "UNI EN 27574; UNI 7137; UNI 7138; UNI 7139.",
